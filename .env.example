# ══════════════════════════════════════════════════════════════════
#  Nexora — Environment Variables Reference
#  Copy to .env.local and fill in your values.
#  NEVER commit .env.local or any file with real secrets.
# ══════════════════════════════════════════════════════════════════

# ── App ────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://nexora-mu-henna.vercel.app
NEXT_PUBLIC_SITE_URL=https://nexora-mu-henna.vercel.app
NEXT_PUBLIC_APP_VERSION=1.0.0

# ── Supabase (required) ────────────────────────────────────────────
# Get from: https://supabase.com/dashboard → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service role key — ONLY used server-side, never expose to browser
# Grants full DB access, bypasses RLS
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── AI Provider API Keys (server-side only) ─────────────────────────
# All of these are used exclusively in /api/proxy/model-proxy/* routes.
# They must NEVER be added to NEXT_PUBLIC_* variables.

# DeepSeek — https://platform.deepseek.com/api_keys
# Required for: Free, Neo, Pro, Business, Enterprise plans
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Gemini — https://aistudio.google.com/app/apikey
# Required for: Free (Flash), Neo+ (Pro)
GEMINI_API_KEY=AIzaSy-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Anthropic Claude — https://console.anthropic.com/settings/keys
# Required for: Pro (Haiku), Business (Sonnet), Enterprise (Opus)
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# xAI Grok — https://console.x.ai/
# Required for: Pro, Business, Enterprise plans
XAI_API_KEY=xai-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI — https://platform.openai.com/api-keys
# Required for: Enterprise plan (GPT-5)
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Payments (NotchPay) ────────────────────────────────────────────
# https://dashboard.notchpay.co → Settings → API Keys
NOTCHPAY_PUBLIC_KEY=pk.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTCHPAY_SECRET_KEY=sk.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Email (Resend) ─────────────────────────────────────────────────
# https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@nexora.dev

# ── Rate Limiting — Upstash Redis (optional but recommended) ───────
# https://console.upstash.com → Create Database → REST API
# Without this, rate limiting uses in-memory per-instance (not global)
UPSTASH_REDIS_REST_URL=https://xxxxxxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Reranking — Cohere (optional) ─────────────────────────────────
# https://dashboard.cohere.com/api-keys
# Falls back to keyword scoring if not set
COHERE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Web Search & Crawl — Tavily (optional) ─────────────────────────
# https://tavily.com → dashboard → API Keys
# Powers /api/proxy/web (the `@web` chat context provider) and
# /api/proxy/crawl (the docs-site indexing crawler) in the Nexora client.
# Without this, both routes return 503 "not configured" — the rest of
# the product keeps working.
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Telemetry (optional) ────────────────────────────────────────────
# PostHog for product analytics
NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
